<Project Sdk="Microsoft.NET.Sdk">
  <!-- 只做編譯檢查：拿 Unity 附帶的引擎函式庫與 UGUI 原始碼，確認 Assets/Scripts 全部能編譯。不產生可執行檔。 -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>$(NoWarn);CS0618;CS0649;CS0414;CS0067;CS0108;CS0109;CS0612;CS1591;CS0436;CS0169;CS0219;CS0672</NoWarn>
    <UnityDir>D:\Unity\6000.3.12f1\Editor\Data</UnityDir>
    <DefineConstants>UNITY_6000_0_OR_NEWER;UNITY_2023_1_OR_NEWER;UNITY_2022_1_OR_NEWER;UNITY_2021_1_OR_NEWER;UNITY_2019_4_OR_NEWER;UNITY_STANDALONE;UNITY_STANDALONE_WIN</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="$(UnityDir)\Managed\UnityEngine\*.dll" Private="false" />
    <Compile Include="$(UnityDir)\Resources\PackageManager\BuiltInPackages\com.unity.ugui\Runtime\UGUI\**\*.cs" />
    <Compile Include="..\..\Assets\Scripts\**\*.cs" />
    <Compile Include="../../Assets/Editor/**/*.cs" />
  </ItemGroup>
</Project>
